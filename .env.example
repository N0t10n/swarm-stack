# Copy to .env and fill in. On ZimaOS set these in the app's environment settings.

# Brain (Claude Opus) and workers (Together.ai)
ANTHROPIC_API_KEY=
TOGETHERAI_API_KEY=

# LiteLLM admin key, internal only (generate: openssl rand -hex 24, prefix with sk-)
LITELLM_MASTER_KEY=sk-change-me

# Encrypts credentials stored in LiteLLM's database. Generate once (sk- + openssl rand -hex 32) and NEVER change it.
LITELLM_SALT_KEY=sk-change-me

# Lets the LiteLLM admin UI (Chat tab, adding models) store its changes in Postgres
STORE_MODEL_IN_DB=True

# Bearer token clients send to the orchestrator (generate: openssl rand -hex 24)
SWARM_TOKEN=change-me

# Publish the orchestrator only on the server's tailscale IP (tailscale ip -4). Default: all interfaces.
SWARM_BIND=0.0.0.0
WEBUI_PORT=8787

# Memory / cost controls
HISTORY_RESPONSES=20
SUMMARY_EVERY=5
SUMMARY_MODEL=llama-70b
