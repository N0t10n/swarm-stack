# scripts/setup.sh fills the LiteLLM keys for you. You paste the two provider keys.
# On ZimaOS, set these in the app's environment settings (or edit docker-compose.yml).

ANTHROPIC_API_KEY=
TOGETHERAI_API_KEY=

# Generated by scripts/setup.sh (sk- + random). The salt must NEVER change once set.
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me
STORE_MODEL_IN_DB=True

# Budget-capped key Hermes uses (created by scripts/setup.sh). Empty = falls back to the master key.
HERMES_API_KEY=
HERMES_BRAIN_MODEL=brain
HERMES_WORKER_MODEL=glm-flash

# Publish LiteLLM's UI only on the server's tailscale IP (tailscale ip -4). Default: all interfaces.
SWARM_BIND=0.0.0.0
WEBUI_PORT=4000
